# ============================================================================
# OAuth 2.0 Configuration
# ============================================================================
# 설정: 각 OAuth 제공자에서 발급받은 클라이언트 ID/Secret을 입력하세요

# Google OAuth 2.0
# 설정 방법: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5021/auth/google/callback
GOOGLE_SCOPE=openid email profile

# GitHub OAuth 2.0
# 설정 방법: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:5021/auth/github/callback
GITHUB_SCOPE=user:email

# Naver OAuth 2.0
# 설정 방법: https://developers.naver.com/apps
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
NAVER_REDIRECT_URI=http://localhost:5021/auth/naver/callback
NAVER_SCOPE=nickname email

# JWT 암호화
JWT_SECRET=your_jwt_secret_key_min_32_chars_required_for_hs256
JWT_EXPIRY_HOURS=24

# 프로덕션 환경
# 각 환경에서 안전하게 관리하세요:
# - 개발: .env.local (Git 제외)
# - 스테이징: CI/CD 시크릿
# - 프로덕션: 환경 변수 또는 시크릿 매니저
