// ============================================================================
// FreeLang Admin Dashboard - 운영 관리 대시보드
// ============================================================================
// 기능: 블로그 포스트, 댓글, 사용자 관리 UI 컴포넌트

use std::io::*

// ============================================================================
// 대시보드 페이지 구조
// ============================================================================

pub struct AdminDashboard {
  dashboard_id: string,
  title: string,
  pages: map<string, DashboardPage>,
  current_page: string,
  user_role: string,
  theme: string
}

pub struct DashboardPage {
  page_id: string,
  name: string,
  title: string,
  route: string,
  icon: string,
  component: string,
  permissions: array<string>
}

pub struct DashboardStats {
  total_posts: i32,
  total_comments: i32,
  total_users: i32,
  pending_comments: i32,
  active_users_today: i32,
  avg_response_time_ms: f64
}

// ============================================================================
// 대시보드 초기화
// ============================================================================

pub fn create_admin_dashboard() -> Result<AdminDashboard, string>
  intent "관리자 대시보드 생성"
  do
    let dashboard = AdminDashboard {
      dashboard_id: generate_uuid(),
      title: "FreeLang Admin Dashboard",
      pages: {},
      current_page: "overview",
      user_role: "admin",
      theme: "light"
    }

    // 페이지 추가
    add_dashboard_page(&mut dashboard, "overview", "Overview", "/admin", "📊", "OverviewPage", ["admin", "moderator"])
    add_dashboard_page(&mut dashboard, "posts", "Posts", "/admin/posts", "📝", "PostsPage", ["admin", "editor"])
    add_dashboard_page(&mut dashboard, "comments", "Comments", "/admin/comments", "💬", "CommentsPage", ["admin", "moderator"])
    add_dashboard_page(&mut dashboard, "users", "Users", "/admin/users", "👥", "UsersPage", ["admin"])
    add_dashboard_page(&mut dashboard, "analytics", "Analytics", "/admin/analytics", "📈", "AnalyticsPage", ["admin"])
    add_dashboard_page(&mut dashboard, "settings", "Settings", "/admin/settings", "⚙️", "SettingsPage", ["admin"])

    return Ok(dashboard)
  end

fn add_dashboard_page(dashboard: &mut AdminDashboard, page_id: string, name: string, route: string, icon: string, component: string, permissions: array<string>) -> void
  intent "대시보드 페이지 추가"
  do
    let page = DashboardPage {
      page_id: page_id,
      name: name,
      title: name,
      route: route,
      icon: icon,
      component: component,
      permissions: permissions
    }

    dashboard.pages[page_id] = page
  end

// ============================================================================
// HTML 렌더링
// ============================================================================

pub fn render_dashboard_html(dashboard: AdminDashboard) -> string
  intent "대시보드 HTML 렌더링"
  do
    let html = ""

    html = html + render_dashboard_header(dashboard)
    html = html + render_dashboard_sidebar(dashboard)
    html = html + render_dashboard_main_content(dashboard)
    html = html + render_dashboard_footer()

    return html
  end

fn render_dashboard_header(dashboard: AdminDashboard) -> string
  do
    let html = ""

    html = html + "<!DOCTYPE html>\n"
    html = html + "<html lang=\"ko\">\n"
    html = html + "<head>\n"
    html = html + "  <meta charset=\"UTF-8\">\n"
    html = html + "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n"
    html = html + "  <title>" + dashboard.title + "</title>\n"
    html = html + render_dashboard_styles()
    html = html + "</head>\n"
    html = html + "<body>\n"
    html = html + "  <div class=\"dashboard-container\">\n"
    html = html + "    <nav class=\"navbar\">\n"
    html = html + "      <div class=\"navbar-brand\">🚀 FreeLang</div>\n"
    html = html + "      <div class=\"navbar-title\">" + dashboard.title + "</div>\n"
    html = html + "      <div class=\"navbar-user\">\n"
    html = html + "        <span class=\"user-role\">" + dashboard.user_role + "</span>\n"
    html = html + "        <button class=\"logout-btn\">Logout</button>\n"
    html = html + "      </div>\n"
    html = html + "    </nav>\n"

    return html
  end

fn render_dashboard_sidebar(dashboard: AdminDashboard) -> string
  do
    let html = ""

    html = html + "    <div class=\"sidebar\">\n"
    html = html + "      <ul class=\"nav-menu\">\n"

    for page_id in dashboard.pages.keys()
      match dashboard.pages[page_id]
        page => {
          let active = if page_id == dashboard.current_page then "active" else "" end
          html = html + "        <li class=\"nav-item " + active + "\">\n"
          html = html + "          <a href=\"" + page.route + "\" class=\"nav-link\">\n"
          html = html + "            <span class=\"nav-icon\">" + page.icon + "</span>\n"
          html = html + "            <span class=\"nav-label\">" + page.name + "</span>\n"
          html = html + "          </a>\n"
          html = html + "        </li>\n"
        }
        _ => {}
      end
    end

    html = html + "      </ul>\n"
    html = html + "    </div>\n"

    return html
  end

fn render_dashboard_main_content(dashboard: AdminDashboard) -> string
  do
    let html = ""

    html = html + "    <main class=\"main-content\">\n"

    // 현재 페이지에 따라 컨텐츠 렌더링
    match dashboard.current_page
      "overview" => {
        html = html + render_overview_page()
      }
      "posts" => {
        html = html + render_posts_page()
      }
      "comments" => {
        html = html + render_comments_page()
      }
      "users" => {
        html = html + render_users_page()
      }
      "analytics" => {
        html = html + render_analytics_page()
      }
      "settings" => {
        html = html + render_settings_page()
      }
      _ => {
        html = html + render_overview_page()
      }
    end

    html = html + "    </main>\n"
    html = html + "  </div>\n"

    return html
  end

